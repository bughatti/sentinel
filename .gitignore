# Binaries
/sentinel
sentinel-linux-amd64
sentinel-linux-arm64
*.exe

# Go build artifacts
/vendor/

# Config (may contain credentials)
config.yaml
config.yml

# Media files
/media/
/tmp/

# Models (large binary files — store separately)
/deploy/models/
*.onnx
*.engine
*.pt

# Docker volumes
postgres_data/
mosquitto_data/
mosquitto_log/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test artifacts
coverage.out
*.test

# OS
.DS_Store
Thumbs.db

# deps / build artifacts (added 2026-08-08)
node_modules/
/web/dist/
deploy/go2rtc.yaml

# real per-install files and build output (never publish)
config.yaml.bak*
config.yaml.pre-*
docker-compose.yml.pre-*
*.pre-*-bak
/sentinel_test

# detector models: large, and not ours to redistribute
deploy/models/*
!deploy/models/README.md

# Local deployment leftovers. These live beside a real install and carry real
# values: the root compose sets POSTGRES_PASSWORD, and *.bak- copies of broker
# configs have contained a bridge address and remote_password. None belongs in
# a public repository. deploy/docker-compose.yml is the shipped one and stays
# tracked; this rule is anchored to the repository root.
/docker-compose.yml
deploy/Dockerfile.run
*.bak-*
*.bak
