# Copy to .env next to docker-compose.yml and set a real value.
# The stack refuses to start without it rather than shipping a default.
POSTGRES_PASSWORD=choose-a-strong-password

# Set the SAME password inside config.yaml under database.url. The config file
# is literal YAML and does not read environment variables.

# Optional: set if your MQTT broker requires authentication.
# MQTT_USER=
# MQTT_PASSWORD=
